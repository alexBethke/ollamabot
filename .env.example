# Create a bot with https://t.me/BotFather using /newbot.
TELEGRAM_BOT_TOKEN=
# Start the bot, send /id in Telegram, then paste the numeric ID here and restart.
# Empty means no one can access Ollama. Multiple IDs can be comma-separated.
TELEGRAM_ALLOWED_USER_IDS=
# Use an exact installed model name from `ollama list`.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=300
HISTORY_TURNS=10
SYSTEM_PROMPT="You are a helpful assistant. Answer clearly and concisely."
# Existing project directory. Empty disables /code.
CODING_WORKSPACE=
# Optional shell access. Commands run with your OS account's permissions, not in a sandbox.
CODING_ALLOW_COMMANDS=0
